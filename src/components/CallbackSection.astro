---
import ContactForm from './ContactForm';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 md:pb-24" aria-labelledby="callback-heading">
  <div class="flex flex-wrap items-center gap-10 rounded-3xl bg-brand-950 p-8 text-white sm:p-12 md:p-14">
    <div class="min-w-0 flex-[1_1_320px]">
      <h2 id="callback-heading" class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t.productCommon.ctaTitle}</h2>
      <p class="mt-3 text-lg leading-relaxed text-brand-200">{t.productCommon.ctaSubtitle}</p>
    </div>
    <div class="min-w-0 flex-[1_1_420px]">
      <ContactForm client:visible dict={t.contactPage} variant="dark" />
    </div>
  </div>
</section>
