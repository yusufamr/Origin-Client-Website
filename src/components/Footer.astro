---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/logo.png';
import { getLangFromUrl, path, useTranslations } from '../i18n/utils';
import { MAPS_LINK, PHONE_LINK, SOCIAL_LINKS, WHATSAPP_LINK, WHATSAPP_NUMBER } from '../lib/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const quickLinks = [
  { href: path('', lang), label: t.nav.home },
  { href: path('products', lang), label: t.nav.products },
  { href: path('portfolio', lang), label: t.nav.portfolio },
  { href: path('contact', lang), label: t.nav.requestCall },
];
---

<footer class="border-t border-brand-100 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Image src={logo} alt="Origin UPVC" class="h-11 w-auto" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-brand-800/80">{t.footer.tagline}</p>

      <p class="mt-6 text-xs font-extrabold uppercase tracking-widest text-brand-600">{t.footer.followUs}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {SOCIAL_LINKS.map((social) => (
          <a
            href={social.href}
            aria-label={t.social[social.name]}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-11 w-11 items-center justify-center rounded-xl border border-brand-100 text-brand-800 transition hover:border-brand-500 hover:bg-brand-50 hover:text-brand-600"
          >
            <Icon name={social.name} class="h-5 w-5" />
          </a>
        ))}
      </div>
    </div>

    <div>
      <p class="text-xs font-extrabold uppercase tracking-widest text-brand-600">{t.footer.quickLinks}</p>
      <ul class="mt-4 space-y-3">
        {quickLinks.map((link) => (
          <li>
            <a href={link.href} class="text-sm font-medium text-brand-900 hover:text-brand-600">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-xs font-extrabold uppercase tracking-widest text-brand-600">{t.footer.contactUs}</p>
      <ul class="mt-4 space-y-3 text-sm font-medium text-brand-900">
        {t.footer.phone && (
          <li class="flex items-center gap-2">
            <Icon name="phone" class="h-4 w-4 shrink-0 text-brand-500" />
            <a href={PHONE_LINK} class="hover:text-brand-600">
              <bdi dir="ltr">{t.footer.phone}</bdi>
            </a>
          </li>
        )}
        <li class="flex items-center gap-2">
          <Icon name="whatsapp" class="h-4 w-4 shrink-0 text-brand-500" />
          <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="hover:text-brand-600">
            {t.footer.whatsapp}: <bdi dir="ltr">{WHATSAPP_NUMBER}</bdi>
          </a>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="map-pin" class="h-4 w-4 shrink-0 text-brand-500" />
          <a href={MAPS_LINK} target="_blank" rel="noopener noreferrer" class="hover:text-brand-600">
            {t.footer.address}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-brand-100 py-5">
    <p class="mx-auto max-w-6xl px-4 text-center text-xs text-brand-700 sm:px-6">
      &copy; {year} {t.footer.copyright}
    </p>
  </div>
</footer>
