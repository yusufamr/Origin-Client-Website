---
// Dark intro band for inner pages; continues the navbar's dark background.
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="bg-brand-950 text-white">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 pb-16 pt-12 sm:px-6 md:pb-20 md:pt-16">
    <slot name="eyebrow" />
    <h1 class="max-w-3xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{title}</h1>
    {intro && <p class="max-w-2xl text-lg leading-relaxed text-brand-200">{intro}</p>}
    <slot />
  </div>
</section>
