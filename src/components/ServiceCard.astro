---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  icon: IconName;
  title: string;
  description: string;
  href: string;
  ctaLabel: string;
}

const { icon, title, description, href, ctaLabel } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col gap-3 rounded-3xl border border-brand-100 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-950/10"
>
  <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 transition group-hover:bg-brand-600 group-hover:text-white">
    <Icon name={icon} class="h-7 w-7" />
  </span>
  <h3 class="mt-2 text-xl font-extrabold text-brand-950">{title}</h3>
  <p class="flex-1 text-[15px] leading-relaxed text-brand-800/80">{description}</p>
  <span class="mt-2 inline-flex items-center gap-1 text-sm font-bold text-brand-600 group-hover:text-brand-800">
    {ctaLabel}
    <Icon name="chevron-right" class="h-4 w-4 transition group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5" />
  </span>
</a>
