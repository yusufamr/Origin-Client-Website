---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  icon: IconName;
  title: string;
  description: string;
  href: string;
  learnMoreLabel: string;
}

const { icon, title, description, href, learnMoreLabel } = Astro.props;
---

<article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
    <Icon name={icon} class="h-6 w-6" />
  </div>
  <h3 class="mt-4 text-lg font-bold text-slate-900">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{description}</p>
  <a href={href} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800">
    {learnMoreLabel}
    <Icon name="chevron-right" class="h-4 w-4 rtl:rotate-180" />
  </a>
</article>
