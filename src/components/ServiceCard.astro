---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  icon: IconName;
  title: string;
  description: string;
  href: string;
  learnMoreLabel: string;
  image?: string;
}

const { icon, title, description, href, learnMoreLabel, image } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-3xl border border-brand-100 bg-white transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-950/10"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-100">
    {image ? (
      <img
        src={image}
        alt={title}
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-brand-500">
        <Icon name={icon} class="h-14 w-14" />
      </div>
    )}
    <span class="absolute start-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white text-brand-700 shadow-sm">
      <Icon name={icon} class="h-5 w-5" />
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-6">
    <h3 class="text-xl font-extrabold text-brand-950">{title}</h3>
    <p class="flex-1 text-[15px] leading-relaxed text-brand-800/80">{description}</p>
    <span class="mt-2 inline-flex items-center gap-1 text-sm font-bold text-brand-600 group-hover:text-brand-800">
      {learnMoreLabel}
      <Icon name="chevron-right" class="h-4 w-4 transition group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5" />
    </span>
  </div>
</a>
