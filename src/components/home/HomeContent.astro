---
import ServiceCard from '../ServiceCard.astro';
import WhyUsPoint from '../WhyUsPoint.astro';
import JsonLd from '../JsonLd.astro';
import { getLangFromUrl, path, useTranslations } from '../../i18n/utils';
import { getPortfolioItems } from '../../lib/dataStore';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPortfolioItems = await getPortfolioItems();
const latestPortfolioItems = [...allPortfolioItems]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);
---

<JsonLd />

<section class="bg-gradient-to-b from-brand-800 to-brand-950 text-white">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-20 sm:px-6 md:py-28">
    <h1 class="max-w-2xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
      {t.hero.title}
    </h1>
    <p class="max-w-xl text-lg leading-relaxed text-brand-100">
      {t.hero.subtitle}
    </p>
    <a
      href={path('contact', lang)}
      class="inline-flex items-center rounded-full bg-white px-6 py-3 text-sm font-bold text-brand-800 shadow-lg transition hover:bg-brand-50"
    >
      {t.hero.cta}
    </a>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20" aria-labelledby="services-heading">
  <div class="mx-auto max-w-2xl text-center">
    <h2 id="services-heading" class="text-3xl font-extrabold tracking-tight text-slate-900">{t.services.title}</h2>
    <p class="mt-3 text-slate-600">{t.services.subtitle}</p>
  </div>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
    <ServiceCard
      icon="windows"
      title={t.services.windows.title}
      description={t.services.windows.description}
      href={path('products/windows', lang)}
      learnMoreLabel={t.services.learnMore}
    />
    <ServiceCard
      icon="shower"
      title={t.services.showerCabins.title}
      description={t.services.showerCabins.description}
      href={path('products/shower-cabins', lang)}
      learnMoreLabel={t.services.learnMore}
    />
    <ServiceCard
      icon="shutters"
      title={t.services.shutters.title}
      description={t.services.shutters.description}
      href={path('products/shutters', lang)}
      learnMoreLabel={t.services.learnMore}
    />
  </div>
</section>

<section class="bg-slate-50 py-16 md:py-20" aria-labelledby="why-us-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="why-us-heading" class="text-3xl font-extrabold tracking-tight text-slate-900">{t.whyUs.title}</h2>
      <p class="mt-3 text-slate-600">{t.whyUs.subtitle}</p>
    </div>

    <div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2">
      {t.whyUs.points.map((point) => (
        <WhyUsPoint title={point.title} description={point.description} />
      ))}
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20" aria-labelledby="portfolio-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 id="portfolio-heading" class="text-3xl font-extrabold tracking-tight text-slate-900">
        {t.portfolioTeaser.title}
      </h2>
      <p class="mt-3 max-w-xl text-slate-600">{t.portfolioTeaser.subtitle}</p>
    </div>
    <a href={path('portfolio', lang)} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800">
      {t.portfolioTeaser.seeAll}
    </a>
  </div>

  {latestPortfolioItems.length > 0 && (
    <div class="mt-10 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {latestPortfolioItems.map((item) => (
        <a
          href={path('portfolio', lang)}
          class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
        >
          <div class="aspect-[4/3] overflow-hidden bg-slate-100">
            <img
              src={item.imagePath}
              alt={lang === 'ar' ? item.descriptionAr : item.descriptionEn}
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
            />
          </div>
          <p class="p-4 text-sm text-slate-700">{lang === 'ar' ? item.descriptionAr : item.descriptionEn}</p>
        </a>
      ))}
    </div>
  )}
</section>
