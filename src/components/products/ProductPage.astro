---
import Icon from '../Icon.astro';
import PageHeader from '../PageHeader.astro';
import CallbackSection from '../CallbackSection.astro';
import { path, useTranslations, type Lang } from '../../i18n/utils';
import type { Product } from '../../lib/dataStore';
import { productIcon } from '../../lib/site';

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = useTranslations(lang);

const title = lang === 'ar' ? product.titleAr : product.titleEn;
const tagline = lang === 'ar' ? product.taglineAr : product.taglineEn;
const article = lang === 'ar' ? product.articleAr : product.articleEn;

function getYoutubeEmbedUrl(watchUrl: string): string {
  try {
    const url = new URL(watchUrl);
    const id = url.searchParams.get('v') ?? url.pathname.split('/').filter(Boolean).pop();
    return `https://www.youtube-nocookie.com/embed/${id}`;
  } catch {
    return watchUrl;
  }
}
---

<PageHeader title={title} intro={tagline}>
  <a
    slot="eyebrow"
    href={path('products', lang)}
    class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-3 py-1.5 text-sm font-semibold text-brand-100 hover:bg-white/20"
  >
    <Icon name={productIcon(product.slug)} class="h-4 w-4" />
    {t.nav.products}
  </a>
  <a
    href={path('contact', lang)}
    class="mt-2 inline-flex items-center rounded-xl bg-accent-500 px-7 py-4 text-base font-extrabold text-brand-950 transition hover:bg-accent-400"
  >
    {t.productCommon.ctaButton}
  </a>
</PageHeader>

<article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
  <div class="whitespace-pre-line text-[17px] leading-[1.8] text-brand-900">{article}</div>
</article>

{
  product.images.length > 0 && (
    <section class="border-y border-brand-100 bg-white py-16 md:py-20" aria-labelledby="photo-examples-heading">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 id="photo-examples-heading" class="text-3xl font-extrabold tracking-tight">
          {t.productCommon.photoExamples}
        </h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {product.images.map((image) => (
            <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-brand-100">
              <img src={image} alt={title} class="h-full w-full object-cover" loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  product.videoUrl && (
    <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 md:py-20" aria-labelledby="video-heading">
      <h2 id="video-heading" class="text-3xl font-extrabold tracking-tight">
        {t.productCommon.watchVideo}
      </h2>
      <div class="mt-8 aspect-video overflow-hidden rounded-3xl bg-brand-950 shadow-xl shadow-brand-950/10">
        <iframe
          class="h-full w-full"
          src={getYoutubeEmbedUrl(product.videoUrl)}
          title={t.productCommon.videoLabel}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    </section>
  )
}

<div class="pt-4">
  <CallbackSection lang={lang} />
</div>
