---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Icon, { type IconName } from '../Icon.astro';
import { getLangFromUrl, path, useTranslations } from '../../i18n/utils';

interface Props {
  slug: 'windows' | 'shower-cabins' | 'shutters';
}

const { slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const entry = await getEntry('products', `${lang}/${slug}`);
if (!entry) {
  throw new Error(`Missing product content for ${lang}/${slug}`);
}
const { Content } = await render(entry);

const iconMap: Record<Props['slug'], IconName> = {
  windows: 'windows',
  'shower-cabins': 'shower',
  shutters: 'shutters',
};

function getYoutubeEmbedUrl(watchUrl: string): string {
  try {
    const url = new URL(watchUrl);
    const id = url.searchParams.get('v') ?? url.pathname.split('/').filter(Boolean).pop();
    return `https://www.youtube-nocookie.com/embed/${id}`;
  } catch {
    return watchUrl;
  }
}
---

<section class="bg-gradient-to-b from-brand-800 to-brand-950 text-white">
  <div class="mx-auto flex max-w-4xl flex-col items-start gap-4 px-4 py-16 sm:px-6 md:py-20">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10">
      <Icon name={iconMap[slug]} class="h-6 w-6" />
    </div>
    <h1 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{entry.data.title}</h1>
    <p class="max-w-2xl text-lg leading-relaxed text-brand-100">{entry.data.tagline}</p>
  </div>
</section>

<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 md:py-16">
  <div class="prose prose-slate max-w-none prose-headings:font-extrabold prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-a:text-brand-700">
    <Content />
  </div>
</article>

<section class="bg-slate-50 py-14 md:py-16" aria-labelledby="photo-examples-heading">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 id="photo-examples-heading" class="text-2xl font-extrabold tracking-tight text-slate-900">
      {t.productCommon.photoExamples}
    </h2>
    <!-- TODO: replace with client asset -->
    <div class="mt-8 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {entry.data.images.map((image) => (
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <Image src={image.src} alt={image.alt} class="h-full w-full object-cover" />
        </div>
      ))}
    </div>
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 md:py-16" aria-labelledby="video-heading">
  <h2 id="video-heading" class="text-2xl font-extrabold tracking-tight text-slate-900">
    {t.productCommon.watchVideo}
  </h2>
  <!-- TODO: replace with client asset (real product demonstration video) -->
  <div class="mt-6 aspect-video overflow-hidden rounded-2xl border border-slate-200 bg-slate-900 shadow-sm">
    <iframe
      class="h-full w-full"
      src={getYoutubeEmbedUrl(entry.data.videoUrl)}
      title={t.productCommon.videoLabel}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
</section>

<section class="bg-brand-700 text-white">
  <div class="mx-auto flex max-w-4xl flex-col items-start gap-4 px-4 py-14 sm:px-6 md:py-16">
    <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">{t.productCommon.ctaTitle}</h2>
    <p class="max-w-xl text-brand-100">{t.productCommon.ctaSubtitle}</p>
    <a
      href={path('contact', lang)}
      class="inline-flex items-center rounded-full bg-white px-6 py-3 text-sm font-bold text-brand-800 shadow-lg transition hover:bg-brand-50"
    >
      {t.productCommon.ctaButton}
    </a>
  </div>
</section>
