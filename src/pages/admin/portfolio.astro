---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PortfolioManager from '../../components/admin/PortfolioManager';
---

<AdminLayout title="Manage Portfolio">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <a href="/admin" class="inline-flex items-center gap-1 text-sm font-medium text-brand-700 hover:text-brand-800">
      ← Back to Admin
    </a>

    <div class="mt-3">
      <p class="text-xl font-extrabold text-brand-700">Origin UPVC Admin</p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Manage Portfolio</h1>
    </div>

    <div class="mt-8">
      <PortfolioManager client:load />
    </div>
  </div>
</AdminLayout>
