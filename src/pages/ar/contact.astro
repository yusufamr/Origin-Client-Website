---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('ar');
---

<BaseLayout title={t.contactPage.title} description={t.contactPage.description}>
  <section class="mx-auto max-w-xl px-4 py-14 sm:px-6 md:py-20">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{t.contactPage.title}</h1>
    <p class="mt-3 text-slate-600">{t.contactPage.intro}</p>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <ContactForm client:load dict={t.contactPage} />
    </div>
  </section>
</BaseLayout>
