---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactForm from '../../components/ContactForm';
import Icon from '../../components/Icon.astro';
import { useTranslations } from '../../i18n/utils';
import { MAPS_LINK, PHONE_LINK, WHATSAPP_LINK, WHATSAPP_NUMBER } from '../../lib/site';

const t = useTranslations('ar');
---

<BaseLayout title={t.contactPage.title} description={t.contactPage.description}>
  <PageHeader title={t.contactPage.title} intro={t.contactPage.intro} />

  <section class="mx-auto -mt-8 grid max-w-6xl gap-6 px-4 pb-20 sm:px-6 md:pb-24 lg:grid-cols-[1.6fr_1fr]">
    <div class="rounded-3xl border border-brand-100 bg-white p-6 shadow-xl shadow-brand-950/5 sm:p-10">
      <ContactForm client:load dict={t.contactPage} />
    </div>

    <ul class="flex flex-col gap-3">
      <li>
        <a
          href={WHATSAPP_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 rounded-2xl bg-brand-950 p-5 text-white transition hover:bg-brand-900"
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-500 text-brand-950">
            <Icon name="whatsapp" class="h-5 w-5" />
          </span>
          <span>
            <span class="block font-extrabold">{t.footer.whatsapp}</span>
            <bdi dir="ltr" class="text-sm text-brand-200">{WHATSAPP_NUMBER}</bdi>
          </span>
        </a>
      </li>
      <li>
        <a href={PHONE_LINK} class="flex items-center gap-4 rounded-2xl border border-brand-100 bg-white p-5 transition hover:border-brand-500">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
            <Icon name="phone" class="h-5 w-5" />
          </span>
          <bdi dir="ltr" class="font-extrabold">{t.footer.phone}</bdi>
        </a>
      </li>
      <li>
        <a
          href={MAPS_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 rounded-2xl border border-brand-100 bg-white p-5 transition hover:border-brand-500"
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
            <Icon name="map-pin" class="h-5 w-5" />
          </span>
          <span class="font-extrabold">{t.footer.address}</span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
