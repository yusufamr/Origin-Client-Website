---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PortfolioGallery from '../../components/portfolio/PortfolioGallery';
import Pagination from '../../components/Pagination.astro';
import { path, useTranslations } from '../../i18n/utils';
import { getPortfolioItems } from '../../lib/dataStore';
import { paginate } from '../../lib/pagination';

const lang = 'ar' as const;
const t = useTranslations(lang);

const allItems = (await getPortfolioItems()).sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const requestedPage = Number(Astro.url.searchParams.get('page')) || 1;
const { items, currentPage, totalPages } = paginate(allItems, requestedPage);
---

<BaseLayout title={t.portfolioPage.title} description={t.portfolioPage.description}>
  <PageHeader title={t.portfolioPage.title} intro={t.portfolioPage.intro} />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
    {items.length > 0 ? (
      <PortfolioGallery
        client:load
        items={items}
        lang={lang}
        dateLabel={t.portfolioPage.dateLabel}
        viewImageLabel={t.portfolioPage.viewImage}
        closeLabel={t.common.close}
      />
    ) : (
      <p class="text-brand-700">{t.portfolioPage.empty}</p>
    )}

    <Pagination currentPage={currentPage} totalPages={totalPages} basePath={path('portfolio', lang)} lang={lang} />
  </section>
</BaseLayout>
