---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductPage from '../../../components/products/ProductPage.astro';
import { getProductBySlug } from '../../../lib/dataStore';

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : undefined;

if (!product) {
  return Astro.redirect('/ar/products/');
}
---

<BaseLayout title={product.titleAr} description={product.taglineAr}>
  <ProductPage product={product} lang="ar" />
</BaseLayout>
