---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import { path, useTranslations } from '../../../i18n/utils';
import { getProducts } from '../../../lib/dataStore';

const lang = 'ar' as const;
const t = useTranslations(lang);

const products = await getProducts();
---

<BaseLayout title={t.productsPage.title} description={t.productsPage.description}>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{t.productsPage.title}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.productsPage.intro}</p>

    {products.length > 0 ? (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
        {products.map((product) => (
          <ServiceCard
            icon="box"
            title={product.titleAr}
            description={product.taglineAr}
            href={path(`products/${product.slug}`, lang)}
            learnMoreLabel={t.services.learnMore}
          />
        ))}
      </div>
    ) : (
      <p class="mt-10 text-slate-500">{t.productsPage.empty}</p>
    )}
  </section>
</BaseLayout>
