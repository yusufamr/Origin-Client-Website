---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import CallbackSection from '../../../components/CallbackSection.astro';
import Pagination from '../../../components/Pagination.astro';
import { path, useTranslations } from '../../../i18n/utils';
import { getProducts } from '../../../lib/dataStore';
import { paginate } from '../../../lib/pagination';
import { productIcon } from '../../../lib/site';

const lang = 'en' as const;
const t = useTranslations(lang);

const allProducts = await getProducts();
const requestedPage = Number(Astro.url.searchParams.get('page')) || 1;
const { items: products, currentPage, totalPages } = paginate(allProducts, requestedPage);
---

<BaseLayout title={t.productsPage.title} description={t.productsPage.description}>
  <PageHeader title={t.productsPage.title} intro={t.productsPage.intro} />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
    {products.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <ServiceCard
            icon={productIcon(product.slug)}
            title={product.titleEn}
            description={product.taglineEn}
            href={path(`products/${product.slug}`, lang)}
            learnMoreLabel={t.services.learnMore}
            image={product.images[0]}
          />
        ))}
      </div>
    ) : (
      <p class="text-brand-700">{t.productsPage.empty}</p>
    )}

    <Pagination currentPage={currentPage} totalPages={totalPages} basePath={path('products', lang)} lang={lang} />
  </section>

  <CallbackSection lang={lang} />
</BaseLayout>
